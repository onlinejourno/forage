# Forage — copy to .env. The analyser is keyless; all optional.

# Where to store the audit-log SQLite DB (defaults to webapp/audit_log.db).
# AUDIT_LOG_PATH=

# Optional: your own SerpAPI key for real Google/Bing indexed page counts per
# section (see DEPLOY.md). Bring your own; omit to skip that enrichment.
# SERPAPI_KEY=

# Name of the proxy header carrying the real client IP, used as the rate-limit
# key. UNSET (the default) trusts no header and keys on the socket peer address
# — correct and safe for a bare deploy. Set it ONLY if this app sits behind a
# proxy you control, and only to a header that proxy OVERWRITES rather than
# appends (Fly: fly-client-ip; nginx with `proxy_set_header X-Forwarded-For
# $remote_addr`: x-forwarded-for). Trusting an appended header re-opens the
# spoof hole this setting exists to close.
# FORAGE_TRUSTED_CLIENT_IP_HEADER=fly-client-ip
