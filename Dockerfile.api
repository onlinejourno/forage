# Crawl-Budget Analyser — FastAPI JSON API (OnlineJourno Tools, Phase 2).
# Separate from the Streamlit Dockerfile so the parallel Streamlit work is untouched.
FROM python:3.11-slim

WORKDIR /app

COPY webapp/requirements-api.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY webapp/ ./webapp/

EXPOSE 8080

CMD ["uvicorn", "webapp.api:app", "--host", "0.0.0.0", "--port", "8080"]
